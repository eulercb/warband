{
  "name": "warband",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Warband \u2014 a browser-hosted, peer-to-peer co-op boss fight. Host in your tab, share a link, fell one great monster together.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/gen-icons.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:mobile": "node scripts/smoke-mobile.mjs",
    "smoke:rewards": "node scripts/smoke-rewards.mjs",
    "smoke:rooms": "node scripts/smoke-rooms.mjs",
    "relay": "node server/relay.mjs",
    "smoke:moon-form": "node scripts/smoke-moon-form.mjs",
    "smoke:companions": "node scripts/smoke-companions.mjs",
    "smoke:passives": "node scripts/smoke-passives.mjs",
    "smoke:spells": "node scripts/smoke-spells.mjs",
    "smoke:support": "node scripts/smoke-support.mjs",
    "smoke:martial": "node scripts/smoke-martial.mjs",
    "smoke:absorption": "node scripts/smoke-absorption.mjs",
    "smoke:auras": "node scripts/smoke-auras.mjs",
    "smoke:caster-defense": "node scripts/smoke-caster-defense.mjs",
    "smoke:enemy-debuffs": "node scripts/smoke-enemy-debuffs.mjs",
    "smoke:defensive-identity": "node scripts/smoke-defensive-identity.mjs",
    "smoke:defense-recovery": "node scripts/smoke-defense-recovery.mjs",
    "smoke:coherence": "node scripts/smoke-coherence.mjs",
    "smoke:upgrade-pilot": "node scripts/smoke-upgrade-pilot.mjs",
    "smoke:upgrade-foundations": "node scripts/smoke-upgrade-foundations.mjs",
    "smoke:cadence-range": "node scripts/smoke-cadence-range.mjs",
    "smoke:grand-selections": "node scripts/smoke-grand-selections.mjs",
    "smoke:pilot-grands": "node scripts/smoke-pilot-grands.mjs",
    "smoke:pilot-coherence": "node scripts/smoke-pilot-coherence.mjs"
  },
  "dependencies": {
    "@trystero-p2p/torrent": "0.25.2",
    "pixi.js": "8.19.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.56.0",
    "prettier": "3.9.4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "8.1.3",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.9",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
